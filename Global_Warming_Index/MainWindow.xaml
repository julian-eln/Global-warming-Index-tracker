<Window x:Class="Global_Warming_Index.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="Global Warming Index" Height="600" Width="900">
    <Grid Background="#FF310000">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0: doomsday banner -->
            <RowDefinition Height="Auto"/>
            <!-- 1: current stats -->
            <RowDefinition Height="*"/>
            <!-- 2: chart, fills the rest of the window -->
        </Grid.RowDefinitions>

        <!-- Row 0: thresholds banner -->
        <TextBlock Grid.Row="2" Margin="11,0,8.333,522.667" Foreground="#FFFFC77A" FontSize="12" TextWrapping="Wrap"
                   Text="Commonly cited thresholds:  +1.5 °C (Paris goal)   +2.0 °C (Paris upper limit)   CO2 350 ppm (safe level)   560 ppm CO2e (double pre-industrial)"/>

        <!-- Row 1: latest values (and any error message) -->
        <TextBlock x:Name="current" Margin="10,26,-0.667,492.667" Foreground="White" FontSize="20" TextWrapping="Wrap"
                   Text="Loading..." Grid.RowSpan="3"/>

        <!-- Row 2: the chart. x:Name lets the C# code draw on it -->
        <ScottPlot:WpfPlot Grid.Row="2" x:Name="co2Chart" Margin="8" Height="230" Width="400"/>
    </Grid>
</Window>
